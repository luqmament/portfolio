#!/bin/sh
# ============================================================
# pre-commit hook — blocks secrets from being committed
# to a PUBLIC repository.
#
# Install: run `sh setup-hooks.sh` from repo root
# ============================================================

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

BLOCKED_FILES=".env .pem .key .p12 .pfx .jks credentials secrets tokens password passwd htpasswd .htpasswd .gcpkey .azurekey .doCredentials api_key id_rsa known_hosts letsencrypt"
BLOCKED_EXTENSIONS=".env .key .pem .crt .p12 .pfx .jks .bak .backup .old"
GITHUB_TOKEN_PATTERNS="ghp_[a-zA-Z0-9]{36}"
GENERIC_SECRET_PATTERNS="(api[_-]?key|secret[_-]?key|secret|token|password|passwd|aws[_-]?key|private[_-]?key)[\s]*[=:][\s]*['\"]?[a-zA-Z0-9+/_\-]{8,}"

BLOCKED=0

echo ""
echo "🔍 Running security pre-commit checks..."
echo ""

# ── 1. Block known sensitive filenames ──
echo "  [1/4] Checking staged filenames..."
for pattern in $BLOCKED_FILES; do
  STAGED=$(git diff --cached --name-only | grep -iE "(^|/)${pattern}(/|$)" || true)
  if [ -n "$STAGED" ]; then
    echo "     ${RED}✗${NC} BLOCKED — sensitive file: $STAGED"
    BLOCKED=1
  fi
done

# ── 2. Block sensitive file extensions ──
for ext in $BLOCKED_EXTENSIONS; do
  STAGED_EXT=$(git diff --cached --name-only | grep -iE "${ext}$" || true)
  if [ -n "$STAGED_EXT" ]; then
    echo "     ${RED}✗${NC} BLOCKED — sensitive extension: $STAGED_EXT"
    BLOCKED=1
  fi
done

# ── 3. Scan staged file contents for secrets ──
echo "  [2/4] Scanning file contents for secrets..."

# Get list of staged files (text only)
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -vE "\.(png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot|mp3|mp4|webm|pdf|zip|tar|gz)$" || true)

if [ -n "$STAGED_FILES" ]; then
  # Use git show to get staged content (works with renamed files too)
  while IFS= read -r file; do
    CONTENT=$(git show ":$file" 2>/dev/null)
    if [ -z "$CONTENT" ]; then
      continue
    fi

    # Check for GitHub tokens
    if echo "$CONTENT" | grep -qE "$GITHUB_TOKEN_PATTERNS"; then
      echo "     ${RED}✗${NC} BLOCKED — GitHub token found in: $file"
      echo "       Detected: ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
      echo "       ${YELLOW}→${NC} Remove it immediately: https://github.com/settings/tokens"
      BLOCKED=1
    fi

    # Check for generic secrets in = or : assignments
    if echo "$CONTENT" | grep -v "^#" | grep -qE "$GENERIC_SECRET_PATTERNS"; then
      echo "     ${RED}✗${NC} BLOCKED — possible secret in: $file"
      echo "       Pattern matched: api_key, secret, token, password, etc."
      BLOCKED=1
    fi

    # Check for base64-encoded-looking secrets (long base64 strings)
    if echo "$CONTENT" | grep -qE "[A-Za-z0-9+/]{60,}={0,2}"; then
      LONG_BASE64=$(echo "$CONTENT" | grep -oE "[A-Za-z0-9+/]{60,}={0,2}" | head -1)
      if [ -n "$LONG_BASE64" ] && ! echo "$LONG_BASE64" | grep -qE "^(eyJ|Y3Jl|ZnJh|IC0tLSJ|aHR0c|AAAA)[A-Za-z0-9+/=]{10,}"; then
        echo "     ${RED}✗${NC} BLOCKED — suspicious long base64 string in: $file"
        BLOCKED=1
      fi
    fi

    # Check for AWS keys
    if echo "$CONTENT" | grep -qE "(AKIA|ABIA|ASIA)[0-9A-Z]{16}"; then
      echo "     ${RED}✗${NC} BLOCKED — AWS access key in: $file"
      BLOCKED=1
    fi
  done << EOF
$STAGED_FILES
EOF
fi

# ── 4. Check .gitignore exists ──
echo "  [3/4] Checking .gitignore..."
if [ ! -f .gitignore ]; then
  echo "     ${YELLOW}⚠${NC} WARNING: .gitignore not found in repo root"
  echo "       Create one with: touch .gitignore && git add .gitignore"
fi

# ── 5. Warn about .env in staging ──
STAGED_DOTENV=$(git diff --cached --name-only | grep -E "\.env" || true)
if [ -n "$STAGED_DOTENV" ]; then
  echo ""
  echo "  ${YELLOW}⚠ WARNING: .env file is staged!${NC}"
  echo "    Files: $STAGED_DOTENV"
  echo "    .env files should NEVER be committed to a public repo."
  echo "    Remove from staging: git reset HEAD $STAGED_DOTENV"
  echo ""
fi

echo ""
echo "  [4/4] Checks complete."
echo ""

# ── RESULT ──
if [ "$BLOCKED" = "1" ]; then
  echo "───────────────────────────────────────────"
  echo "  ${RED}❌ COMMIT BLOCKED${NC} — secrets detected."
  echo "  Fix the issues above before committing."
  echo "───────────────────────────────────────────"
  echo ""
  exit 1
fi

echo "  ${GREEN}✅ No secrets detected. Commit allowed.${NC}"
echo ""
exit 0
